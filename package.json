{
  "name": "glow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "exe": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.us.glow",
    "productName": "Emberwake",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
